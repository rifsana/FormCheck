# Auto detect text files and perform LF normalization
* text=auto

# Ensure shell scripts have LF endings
*.sh text eol=lf

# Batch and PowerShell scripts require CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Dart and config files
*.dart text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.kts text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.so binary
